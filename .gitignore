# Large instance data
# Region B .dat files are about 36 MB each. Each teammate copies
# them from the course package into datasets/regionB/.
# Region A and tiny are small and are tracked.
datasets/regionB/*.dat


# Solver and AMPL artifacts
*.nl
*.sol
*.mps
*.lp
*.log
gurobi.log
*.tmp


# Results
# Scratch runs go in results/ and are ignored.
# Results you cite in the report go in results/final/ and are tracked.
results/*
!results/final/
!results/final/**


